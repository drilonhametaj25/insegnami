# InsegnaMi.pro Production Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://insegnami:YOUR_SECURE_PASSWORD@localhost:5432/insegnami?schema=public
POSTGRES_DB=insegnami
POSTGRES_USER=insegnami
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://insegnami.pro

# ===========================================
# STRIPE (Payments)
# ===========================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@insegnami.pro

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=production
MODE=saas
APP_URL=https://insegnami.pro

# ===========================================
# SUPERADMIN (provisioning automatico in deploy.sh)
# ===========================================
# Lo script scripts/create-superadmin.mjs crea/aggiorna l'utente SUPERADMIN
# a ogni deploy. Rieseguire il deploy con una nuova password la reimposta
# (percorso di recovery). Min 8 caratteri con minuscola+maiuscola+cifra.
# ATTENZIONE: il deploy CI sovrascrive il file .env del server a ogni run,
# quindi queste variabili DEVONO esistere anche come GitHub Secrets
# (SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD), altrimenti vanno perse.
SUPERADMIN_EMAIL=admin@insegnami.pro
SUPERADMIN_PASSWORD=ChangeMe-Strong1

# ===========================================
# BACKUP
# ===========================================
# Chiave simmetrica per la cifratura dei backup del database.
# Generare con: openssl rand -base64 32
# Come per le credenziali superadmin: va definita anche come GitHub Secret
# (BACKUP_ENCRYPTION_KEY) perché il deploy riscrive il .env del server.
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key
