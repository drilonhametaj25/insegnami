# Application Mode (self-hosted or saas)
MODE=self-hosted

# Database
DATABASE_URL="postgresql://insegnami_user:insegnami_password@localhost:5432/insegnami_db?schema=public"

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Email Configuration
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@insegnami.pro

# Application Settings
APP_NAME="InsegnaMi.pro"
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@insegnami.pro

# Destinatario interno delle richieste dal form contatti pubblico.
# I lead vengono comunque salvati a DB (contact_requests) anche se l'email fallisce.
CONTACT_TO_EMAIL=info@insegnami.pro

# --- Demo pubblica ---
# Password dell'utente demo@insegnami.pro (tenant 'demo', seed: scripts/seed-demo.ts).
# In produzione DEMO_PASSWORD è OBBLIGATORIA per eseguire il seed demo.
DEMO_PASSWORD=demo1234
# Password esposta al client SOLO per il bottone "Entra nella demo"
# (/auth/login?demo=true). Deve coincidere con DEMO_PASSWORD.
# Se assente, il bottone demo non viene mostrato. L'account demo è un
# ambiente sandbox pubblico resettato ogni notte: NON è un segreto.
NEXT_PUBLIC_DEMO_PASSWORD=demo1234

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx

# Worker/Queue Settings
WORKER_CONCURRENCY=5

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Development
NODE_ENV=development
LOG_LEVEL=info

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=

# Umami (analytics cookieless, opzionale): lo script di tracking viene montato
# SOLO se entrambe le variabili sono valorizzate. URL base dell'istanza Umami
# (es. https://analytics.example.com, senza /script.js) + UUID del sito.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Lato server (docker-compose.prod.yml, servizi umami/umami-db):
# password del DB dedicato + secret di hashing (es. `openssl rand -hex 32`).

# PWA Settings
PWA_ENABLED=true

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
